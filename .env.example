# Copy this file to .env and fill in real values: cp .env.example .env
# Never commit .env — it is gitignored.

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000
# Postgres connection string used by the API and by packages/db migrations/seeds.
DATABASE_URL=postgresql://ride:ride@localhost:5432/ride
# Signing secret for access JWTs (min 32 chars). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-32-plus-character-secret
# Origin allowed to call the API with cookies (CSRF Origin check).
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Web (apps/web) ---
# Internal URL the Next.js server uses to reach the API for its /api rewrite.
API_INTERNAL_URL=http://localhost:4000

# --- Docker Compose (db service) ---
POSTGRES_USER=ride
POSTGRES_PASSWORD=ride
POSTGRES_DB=ride
